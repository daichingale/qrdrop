{
 "name": "QRDrop",
 "short_name": "QRDrop",
 "description": "QRを1回読むだけで、スマホ・PCどうしを直接つないでファイルを送る",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "background_color": "#0f172a",
 "theme_color": "#0f172a",
 "icons": [
  {
   "src": "icon.svg",
   "sizes": "any",
   "type": "image/svg+xml",
   "purpose": "any"
  },
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any maskable"
  }
 ],
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "url": "url",
   "files": [
    {
     "name": "files",
     "accept": [
      "*/*"
     ]
    }
   ]
  }
 }
}